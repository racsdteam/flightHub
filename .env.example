APP_NAME="RAC Flight Data Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Where the hub is served (D-061). Production: APP_URL=https://systems.rac.co.rw/flighthub and
# FLIGHTHUB_BASE_PATH=/flighthub (APP_URL's path; empty = the domain root). The move to a
# subdomain: APP_URL, FLIGHTHUB_BASE_PATH empty and SESSION_PATH=/.
# FLIGHTHUB_BASE_PATH=/flighthub
FLIGHTHUB_BASE_PATH=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3317
DB_DATABASE=flighthub
DB_USERNAME=
DB_PASSWORD=
DB_DDL_USERNAME=
DB_DDL_PASSWORD=
DB_GRANT_HOST=

SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production (D-061): the hub's cookies stay under its base path (KIA PULSE and three other apps
# share the host) and the session cookie has the hub's own name (hub:preflight fails otherwise):
# SESSION_PATH=/flighthub
# SESSION_COOKIE=flighthub_session
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true (hub:preflight fails otherwise). Never leave it empty:
# an empty value means "not secure". Unset locally (http).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production (D-063): MAIL_MAILER=smtp, MAIL_HOST=systems.rac.co.rw, MAIL_PORT=25, MAIL_SCHEME=smtp
# (STARTTLS when offered), MAIL_USERNAME and MAIL_FROM_ADDRESS no_reply@systems.rac.co.rw (the
# mailbox KIA PULSE uses); its password is typed on the server, as in KIA PULSE's .env.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Stale / recovery alert: comma-separated addresses mailed as well as the active admins (empty = none).
ALERT_EXTRA_RECIPIENTS=
# Backup alert (D-058): the folder scripts/backup.sh writes to; empty = check off.
# Production: FLIGHTHUB_BACKUP_DIR=/home/sysrac/flight-hub-backups
# FLIGHTHUB_BACKUP_DIR=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AODB_CLIENT=http
AODB_BASE_URL=https://api.app.airport-keeper.com
AODB_USERNAME=
AODB_PASSWORD=
AODB_AIRPORT=HRYR
AODB_CONNECT_TIMEOUT=10
AODB_TIMEOUT=30
AODB_WINDOW_DAYS_BEFORE=1
AODB_WINDOW_DAYS_AFTER=1
AODB_POLL_CRON="*/5 * * * *"
AODB_LOGIN_BACKOFF_MINUTES=15
AODB_BYID_CHUNK=50
ROTATION_MAX_HOURS=24

QUALITY_NO_ACTUAL_MINUTES=30
QUALITY_ACTUAL_EARLY_MINUTES=60
QUALITY_IN_FLIGHT_STALE_MINUTES=30
QUALITY_DUPLICATE_WINDOW_HOURS=6
