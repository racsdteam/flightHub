* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Third-party font files are kept byte-for-byte as downloaded (D-042).
/public/fonts/* -text

# Swagger UI (swagger-ui-dist) is kept byte-for-byte as downloaded.
/public/vendor/swagger-ui/* -text

# The RAC logo (supplied by RAC, D-053) and the files derived from it, byte-for-byte.
/public/images/* -text
/public/favicon.ico -text
